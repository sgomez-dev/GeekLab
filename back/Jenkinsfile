pipeline {
    agent any
    environment {
        SERVER_REG = "balgittuber"
        /** DEPLOYMENT **/
        APP_NAME = "geeklab-back"
        SCANNER_HOME = tool 'sonarqube'
    }

    stages {
        stage('SonarQube Analysis') {
            steps {
                dir('back') {
                    script {
                        try {
                            withSonarQubeEnv('sonarqube') {
                                sh """
                                    pwd
                                    ls -la sonar-project.properties || echo 'sonar-project.properties not found'
                                    echo 'Testing SonarQube connectivity...'
                                    ${SCANNER_HOME}/bin/sonar-scanner -Dsonar.scanner.force-deprecated-java-version=true
                                """
                            }
                        } catch (Exception e) {
                            echo "SonarQube analysis failed: ${e.getMessage()}"
                            echo "Continuing with deployment..."
                            currentBuild.result = 'UNSTABLE'
                        }
                    }
                }
            }
        }
        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                dir('back') {
                    echo '====== DEPLOYING ======'
                    sh """
                        docker build . -f Dockerfile -t ${SERVER_REG}/${APP_NAME}:${BRANCH_NAME}-${BUILD_ID}
                        docker login 
                        docker push ${SERVER_REG}/${APP_NAME}:${BRANCH_NAME}-${BUILD_ID}

                        export KUBECONFIG=/var/jenkins_home/.kube/kubeconfig.yaml
                        kubectl set image deployment/${APP_NAME} ${APP_NAME}=${SERVER_REG}/${APP_NAME}:${BRANCH_NAME}-${BUILD_ID}
                    """
                }
            }
        }
    }
}